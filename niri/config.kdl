// niri config — https://yalter.github.io/niri/Configuration:-Introduction
// Border/focus-ring colors live in quickshell-colors.kdl (written by quickshell's theme script).

// ── Input ────────────────────────────────────────────────────────────────
input {
    keyboard {
        repeat-delay 200
        repeat-rate 60
        numlock
    }
    touchpad {
        tap
        dwt
        dwtp
        drag true
        drag-lock
        natural-scroll
        accel-speed 0.5
        accel-profile "adaptive"
        click-method "clickfinger"
        tap-button-map "left-right-middle"
        scroll-method "two-finger"
    }
    mouse {
        accel-speed 0.5
    }
    focus-follows-mouse max-scroll-amount="70%"
}

// ── Outputs ──────────────────────────────────────────────────────────────
output "eDP-1" {
    mode "1920x1080@120"
    scale 1.2
    position x=0 y=0
    variable-refresh-rate
}
output "HDMI-A-1" {
    mode "1920x1080@120"
    scale 1
    position x=1600 y=0
    variable-refresh-rate
}

// ── Layout ───────────────────────────────────────────────────────────────
layout {
    gaps 5
    background-color "transparent"
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        off
    }
    border {
        width 2
    }
    shadow {
        on
        softness 10
        spread 5
        offset x=0 y=5
        color "#0007"
    }
    struts {
        left 5
        right 5
    }
}

overview {
    workspace-shadow {
        on
    }
}

animations {
    window-open {
        duration-ms 600
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 300
        curve "ease-out-expo"
    }
    workspace-switch {
        spring damping-ratio=1.0 stiffness=500 epsilon=0.0001
    }
}

// ── Startup & environment ────────────────────────────────────────────────
spawn-at-startup "quickshell"
spawn-sh-at-startup "~/.config/mango/screen-rec.sh --clean"

environment {
    QT_QPA_PLATFORM "wayland"
}

xwayland-satellite {
    path "xwayland-satellite"
}

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd
screenshot-path null

// ── Layer & window rules ─────────────────────────────────────────────────
layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

// All windows: rounded corners.
window-rule {
    geometry-corner-radius 5
    clip-to-geometry true
    draw-border-with-background false
}

// Translucent foot; Mod+O toggles it off/on for the focused window.
window-rule {
    match app-id="^foot$"
    opacity 0.8
}

window-rule {
    match app-id="^steam$"
    draw-border-with-background true
    open-floating true
}

window-rule {
    match app-id="nix-search"
    open-floating true
    default-column-width { fixed 1200; }
    default-window-height { fixed 800; }
}

window-rule {
    match app-id="^cheating-daddy$"
    open-floating true
    open-focused false
    block-out-from "screencast"
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

// ── Keybinds ─────────────────────────────────────────────────────────────
binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Apps & launchers
    Mod+Q repeat=true hotkey-overlay-title="Open a Terminal foot" { spawn "foot"; }
    Mod+N { spawn "foot" "--app-id=nix-search" "-o" "font=IosevkaTerm Nerd Font:size=12" "fish" "-c" "ns; exec fish"; }
    Mod+R hotkey-overlay-title="Run an Application" { spawn-sh "~/.config/quickshell/scripts/launcher.sh"; }
    Mod+E hotkey-overlay-title="Control Centre" { spawn "qs" "ipc" "call" "settings" "toggle"; }
    Mod+V hotkey-overlay-title="Clipboard History" { spawn-sh "~/.config/quickshell/scripts/clipboard.sh"; }
    Mod+Z { spawn-sh "/etc/nixos/scripts/fontpicker.sh"; }
    Mod+O hotkey-overlay-title="Toggle Terminal Transparency" { toggle-window-rule-opacity; }
    Alt+Backslash hotkey-overlay-title="Show Notifications" { spawn-sh "~/.config/quickshell/scripts/notifications.sh"; }
    Mod+BackSpace hotkey-overlay-title="Show Notifications" { spawn-sh "~/.config/quickshell/scripts/notifications.sh"; }

    // Cheating Daddy (niri has no GlobalShortcuts portal, so forward actions to the running app)
    Mod+Alt+Backslash    hotkey-overlay-title="Cheating Daddy: Toggle" { spawn "cheating-daddy" "--action=toggleVisibility"; }
    Mod+Alt+Return       hotkey-overlay-title="Cheating Daddy: Next Step" { spawn "cheating-daddy" "--action=nextStep"; }
    Mod+Alt+M            hotkey-overlay-title="Cheating Daddy: Click-through" { spawn "cheating-daddy" "--action=toggleClickThrough"; }
    Mod+Alt+BracketLeft  { spawn "cheating-daddy" "--action=previousResponse"; }
    Mod+Alt+BracketRight { spawn "cheating-daddy" "--action=nextResponse"; }
    Mod+Alt+Up           { spawn "cheating-daddy" "--action=scrollUp"; }
    Mod+Alt+Down         { spawn "cheating-daddy" "--action=scrollDown"; }
    Mod+Alt+E            { spawn "cheating-daddy" "--action=emergencyErase"; }

    // Lock
    Ctrl+Alt+L hotkey-overlay-title="Lock the Screen" { spawn-sh "~/.config/quickshell/scripts/lock.sh"; }
    Mod+Alt+L  hotkey-overlay-title=null { spawn-sh "~/.config/quickshell/scripts/lock.sh"; }

    // Media keys
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext        allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev        allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioStop        allow-when-locked=true { spawn "playerctl" "stop"; }
    Mod+Alt+Space allow-when-locked=true hotkey-overlay-title="Play / Pause" { spawn "playerctl" "play-pause"; }
    Mod+Alt+Right allow-when-locked=true hotkey-overlay-title="Next Track" { spawn "playerctl" "next"; }
    Mod+Alt+Left  allow-when-locked=true hotkey-overlay-title="Previous Track" { spawn "playerctl" "previous"; }
    Mod+Alt+Y hotkey-overlay-title="Toggle Lyrics" { spawn "qs" "ipc" "call" "lyrics" "toggle"; }
    Mod+Shift+N hotkey-overlay-title="Toggle Notes" { spawn "qs" "ipc" "call" "notes" "toggle"; }

    // Brightness
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "~/.config/quickshell/scripts/brightness.sh up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "~/.config/quickshell/scripts/brightness.sh down"; }
    Mod+Alt+Page_Up   allow-when-locked=true repeat=false hotkey-overlay-title="Monitor Brightness Up" { spawn "monitor-brightness" "up"; }
    Mod+Alt+Page_Down allow-when-locked=true repeat=false hotkey-overlay-title="Monitor Brightness Down" { spawn "monitor-brightness" "down"; }

    // Launcher keys
    XF86HomePage   hotkey-overlay-title="Browser" { spawn "helium"; }
    XF86Mail       hotkey-overlay-title="Mail" { spawn "helium" "https://mail.google.com"; }
    F1             hotkey-overlay-title="YouTube" { spawn "helium" "https://www.youtube.com"; }
    XF86Tools      hotkey-overlay-title="YouTube" { spawn "helium" "https://www.youtube.com"; }
    XF86Explorer   hotkey-overlay-title="Files" { spawn "nemo"; }
    XF86Calculator hotkey-overlay-title="Calculator" { spawn "gnome-calculator"; }

    // Windows
    Mod+Tab repeat=true { toggle-overview; }
    Mod+C repeat=true { close-window; }

    // Focus
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-workspace-down; }
    Mod+K     { focus-workspace-up; }
    Mod+L     { focus-column-right; }
    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    // Move
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Shift+H    { move-column-left; }
    Mod+Shift+J    { move-window-down; }
    Mod+Shift+K    { move-window-up; }
    Mod+Shift+L    { move-column-right; }
    Mod+Ctrl+Home  { move-column-to-first; }
    Mod+Ctrl+End   { move-column-to-last; }

    // Monitors
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }
    Mod+Shift+G allow-when-locked=true hotkey-overlay-title="Switch Monitor: Laptop/PS5" { spawn "monitor-switch"; }
    Mod+Shift+P { power-off-monitors; }

    // Workspaces
    Mod+Page_Down       { focus-workspace-down; }
    Mod+Page_Up         { focus-workspace-up; }
    Mod+U               { focus-workspace-down; }
    Mod+I               { focus-workspace-up; }
    Mod+Ctrl+Page_Down  { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up    { move-column-to-workspace-up; }
    Mod+Ctrl+U          { move-column-to-workspace-down; }
    Mod+Ctrl+I          { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    Alt+1 { move-column-to-workspace 1; }
    Alt+2 { move-column-to-workspace 2; }

    // Mouse wheel
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }
    Mod+Shift+WheelScrollDown { move-column-right; }
    Mod+Shift+WheelScrollUp   { move-column-left; }
    Alt+WheelScrollDown       { focus-column-right; }
    Alt+WheelScrollUp         { focus-column-left; }

    // Columns & sizing
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+W      { toggle-column-tabbed-display; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Alt+Shift+F { expand-column-to-available-width; }
    Alt+Shift+C { center-column; }
    Mod+Ctrl+C  { center-visible-columns; }
    Mod+Minus       { set-column-width "-10%"; }
    Mod+Equal       { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+Ctrl+R      { reset-window-height; }
    Alt+H { set-column-width "-5%"; }
    Alt+L { set-column-width "+5%"; }
    Alt+J { set-window-height "+5%"; }
    Alt+K { set-window-height "-5%"; }
    Mod+T       { toggle-window-floating; }
    Mod+Shift+T { switch-focus-between-floating-and-tiling; }

    // Keyboard layout
    Mod+Space       { switch-layout "next"; }
    Mod+Shift+Space { switch-layout "prev"; }

    // Screenshots & recording
    Print       { screenshot-screen; }
    Shift+Print { screenshot; }
    Mod+Print   { screenshot-window; }
    Mod+Shift+S hotkey-overlay-title="Screenshot Region" { screenshot; }
    Mod+Ctrl+S  hotkey-overlay-title="Screenshot Screen" { screenshot-screen; }
    Mod+Alt+S   hotkey-overlay-title="Screenshot Window" { screenshot-window; }
    Ctrl+Alt+R  hotkey-overlay-title="Start or stop a screen recording" { spawn-sh "~/.config/quickshell/scripts/record-toggle.sh"; }
    Mod+Shift+R { spawn-sh "~/.config/quickshell/scripts/record-toggle.sh"; }

    // Session
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E     { quit; }
    Ctrl+Alt+Delete { quit; }
}

// Alt+Tab window switcher (Mod+Tab is the overview, above).
recent-windows {
    debounce-ms 750
    open-delay-ms 150
    highlight {
        active-color "#999999ff"
        urgent-color "#ff9999ff"
        padding 15
        corner-radius 0
    }
    previews {
        max-height 300
        max-scale 0.5
    }
    binds {
        Alt+Tab         { next-window; }
        Alt+Shift+Tab   { previous-window; }
        Alt+grave       { next-window     filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
        Mod+grave       { next-window     filter="app-id"; }
        Mod+Shift+grave { previous-window filter="app-id"; }
    }
}

include "quickshell-colors.kdl"
